
@model VeterinerKlinik.Web.Models.Hizmet

@{
    ViewData["Title"] = "Hizmet Sil";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <h2 class="text-danger mb-3">Hizmet Sil</h2>

                    <div class="alert alert-warning">
                        Bu hizmeti silmek istediğinize emin misiniz?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Hizmet Adı</dt>
                        <dd class="col-sm-8">@Model.Ad</dd>

                        <dt class="col-sm-4">Süre</dt>
                        <dd class="col-sm-8">@Model.SureDakika dk</dd>

                        <dt class="col-sm-4">Ücret</dt>
                        <dd class="col-sm-8">
                            @Model.Ucret.ToString("N2") TL
                        </dd>
                    </dl>

                    <p class="text-muted">
                        Randevularda kullanılmış hizmetler silinemez.
                    </p>

                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        <button type="submit" class="btn btn-danger">
                            Evet, Sil
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            İptal
                        </a>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
